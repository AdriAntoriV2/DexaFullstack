generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeRole {
  EMPLOYEE
  HR
}

enum AttendanceTimingStatus {
  EARLY
  ON_TIME
  LATE
}

model Employee {
  id           String       @id @default(uuid()) @db.Uuid
  companyEmail String       @unique @map("company_email") @db.VarChar(255)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  fullName     String       @map("full_name") @db.VarChar(150)
  photoUrl     String?      @map("photo_url") @db.VarChar(2048)
  position     String       @db.VarChar(100)
  phoneNumber  String?      @map("phone_number") @db.VarChar(30)
  role         EmployeeRole @default(EMPLOYEE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  attendances Attendance[]

  @@map("employees")
}

model Attendance {
  id             String   @id @default(uuid()) @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  attendanceDate DateTime @map("attendance_date") @db.Date
  checkInAt      DateTime? @map("check_in_at") @db.Timestamptz(3)
  checkOutAt     DateTime? @map("check_out_at") @db.Timestamptz(3)
    checkInStatus  AttendanceTimingStatus? @map("check_in_status")
  checkOutStatus AttendanceTimingStatus? @map("check_out_status")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@map("attendance_records")
}

model HrNotification {
  id           String    @id @default(uuid()) @db.Uuid
  type         String    @db.VarChar(100)
  employeeId   String    @map("employee_id") @db.Uuid
  changedFields String[] @map("changed_fields")
  message      String    @db.VarChar(500)
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  readAt       DateTime? @map("read_at") @db.Timestamptz(3)

  @@index([occurredAt])
  @@index([readAt, occurredAt])
  @@map("hr_notifications")
}